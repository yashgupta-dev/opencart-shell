{
    "name": "codecorner/laravel-setup-wizard",
    "description": "Browser setup wizard that starts automatically on `php artisan serve` for a fresh Laravel project.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "CodeCorner\\SetupWizard\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CodeCorner\\SetupWizard\\SetupWizardServiceProvider"
            ]
        }
    }
}